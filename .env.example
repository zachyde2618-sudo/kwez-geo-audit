# Copy to .env.local and fill in what you have. Every key is optional:
# checks that need a missing key report "Unable to Verify".

ANTHROPIC_API_KEY=        # LLM-judged checks + Claude visibility tests
OPENAI_API_KEY=           # ChatGPT visibility tests
GEMINI_API_KEY=           # Gemini visibility tests
PERPLEXITY_API_KEY=       # Perplexity visibility tests + cited sources
PAGESPEED_API_KEY=        # Google PageSpeed Insights (free)
SEARCH_API_KEY=           # web search for third-party mentions (Brave Search API or Serper)
SEARCH_API_PROVIDER=brave # brave | serper
COMPANIES_HOUSE_API_KEY=  # free key from developer.company-information.service.gov.uk
CRAWLER_CONTACT_URL=      # shown in the crawler user agent, e.g. https://kwez.co.uk/geo-audit-bot

# Optional model overrides (defaults live in src/config.ts)
# ANTHROPIC_JUDGE_MODEL=
# ANTHROPIC_VISIBILITY_MODEL=
# OPENAI_MODEL=
# GEMINI_MODEL=
# PERPLEXITY_MODEL=

# Optional behaviour flags
# ENABLE_PLAYWRIGHT=false    # compare raw vs rendered HTML (check 1.5)
# BOT_UA_PROBES=true         # probe homepage with AI-bot user agents (check 1.6, indicative only)
# ALLOW_LOCAL_TARGETS=false  # only for local fixture tests
# AUDITS_DIR=./data/audits
